        // Helper for Yahoo Finance (Free via Proxy with Fallback)
        async function fetchYahooData(symbol) {
            try {
                // Using 1m interval for most fresh state, range 1d
                const yahooUrl = `https://query1.finance.yahoo.com/v8/finance/chart/${symbol}?interval=1m&range=1d`;
                const rawData = await fetchWithProxy(yahooUrl);

                if (!rawData.chart || !rawData.chart.result || rawData.chart.result.length === 0) {
                    return null;
                }

                const result = rawData.chart.result[0];
                const meta = result.meta;

                // Priority: regularMarketPrice -> last indicators.quote close
                let price = meta.regularMarketPrice;
                if (!price && result.indicators && result.indicators.quote[0].close) {
                    const closes = result.indicators.quote[0].close.filter(c => c !== null);
                    if (closes.length > 0) price = closes[closes.length - 1];
                }

                const prevClose = meta.chartPreviousClose || meta.previousClose;
                let changePercent = 0;

                if (price && prevClose) {
                    changePercent = ((price - prevClose) / prevClose) * 100;
                }

                return { price, change_percent: changePercent };
            } catch (e) {
                console.error(`Yahoo Proxy Error (${symbol}):`, e);
                return null;
            }
        }


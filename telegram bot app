        // Helper to fetch Fund Data (TEFAS Scraping via Proxy)
        async function fetchFunds() {
            const funds = [
                'TTE', 'IPB', 'TCD', 'MAC', 'YAS', 'AFT'
            ];

            // Select all fund cards to update
            const cards = document.querySelectorAll('.fund-card');

            // Concurrent fetching using Promise.all
            await Promise.all(funds.map(async (fundCode, index) => {
                const card = cards[index];
                if (!card) return;

                const targetUrl = `https://www.tefas.gov.tr/FonAnaliz.aspx?FonKod=${fundCode}`;
                // Using multi-proxy fallback similar to calendar
                const proxies = [
                    { url: u => `https://api.allorigins.win/get?url=${encodeURIComponent(u)}`, type: 'json' },
                    { url: u => `https://corsproxy.io/?${encodeURIComponent(u)}`, type: 'text' }
                ];

                let htmlContent = null;
                for (const proxy of proxies) {
                    try {
                        const proxyUrl = proxy.url(targetUrl);
                        const res = await fetch(proxyUrl);
                        if (!res.ok) continue;

                        if (proxy.type === 'json') {
                            const json = await res.json();
                            if (json.contents) htmlContent = json.contents;
                        } else {
                            htmlContent = await res.text();
                        }
                        if (htmlContent) break;
                    } catch (e) {
                        console.warn(`Proxy failed for ${fundCode}:`, e);
                    }
                }

                if (htmlContent) {
                    // Robust regex scraping based on list structure
                    // Price: <li>Son Fiyat (TL)<br />...<span>1,052657</span>
                    const priceMatch = htmlContent.match(/Son Fiyat \(TL\)[\s\S]*?<span>([\d,]+)<\/span>/);

                    // Daily Change: <li>Günlük Getiri (%)<br />...<span>%0,2625</span>
                    const dailyChangeMatch = htmlContent.match(/Günlük Getiri \(%\)[\s\S]*?<span>(%\s*[\d,.-]+)<\/span>/);

                    // Date: Inside Highcharts categories array: categories: ["01.01.2025", ..., "10.01.2025"]
                    const dateMatch = htmlContent.match(/categories"\s*:\s*\[([^\]]+)\]/);

                    if (priceMatch) {
                        card.querySelector('.cal-actual').innerText = `₺${priceMatch[1]}`;
                    }
                    if (dailyChangeMatch) {
                        const rawChange = dailyChangeMatch[1];
                        const changeEl = card.querySelector('.change');
                        changeEl.innerText = rawChange;

                        // Parse color
                        if (rawChange.includes('-')) {
                            changeEl.className = 'change down';
                        } else {
                            changeEl.className = 'change up';
                        }
                    }
                    if (dateMatch) {
                        // Extract the last date from the categories array string
                        try {
                            const dates = dateMatch[1].split(',');
                            const lastDate = dates[dates.length - 1].replace(/["']/g, '').trim();

                            let dateEl = card.querySelector('.fund-date');
                            if (!dateEl) {
                                dateEl = document.createElement('div');
                                dateEl.className = 'fund-date';
                                dateEl.style.fontSize = '10px';
                                dateEl.style.color = '#94a3b8';
                                dateEl.style.marginTop = '4px';
                                card.querySelector('.cal-info').appendChild(dateEl);
                            }
                            dateEl.innerText = lastDate;
                        } catch (e) {
                            console.warn('Date parsing error', e);
                        }
                    }
                }
            }));
        }



<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crypto Dashboard PRO - Mini App</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            /* Dark Mode (Zinc-950 & Deep Space) */
            --bg-color: #09090b;
            --bg-gradient: radial-gradient(circle at center, #18181b 0%, #09090b 100%);
            --card-bg: rgba(24, 24, 27, 0.6);
            --accent-color: #8b5cf6;
            /* Saf Mor/Indigo */
            --text-color: #f8fafc;
            --text-muted: #a1a1aa;
            --success-color: #10b981;
            /* Canlı Zümrüt */
            --danger-color: #f43f5e;
            /* Neon Gül */
            --accent-blue: #0ea5e9;
            /* Elektrik Mavisi */
            --glass-border: rgba(255, 255, 255, 0.08);
            --nav-bg: rgba(9, 9, 9, 0.7);
            --card-blur: 20px;
            --card-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        [data-theme="light"] {
            /* Light Mode (Pristine Snow) */
            --bg-color: #f8fafc;
            --bg-gradient: radial-gradient(circle at center, #ffffff 0%, #f1f5f9 100%);
            --card-bg: rgba(255, 255, 255, 0.4);
            --accent-color: #7c3aed;
            --text-color: #0f172a;
            --text-muted: #64748b;
            --success-color: #059669;
            --danger-color: #e11d48;
            --accent-blue: #0284c7;
            --glass-border: rgba(15, 23, 42, 0.05);
            --nav-bg: rgba(248, 250, 252, 0.7);
            --card-blur: 15px;
            --card-shadow: 0 8px 32px 0 rgba(148, 163, 184, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Outfit', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            background: var(--bg-gradient);
            color: var(--text-color);
            padding: 20px;
            padding-bottom: 100px;
            overflow-x: hidden;
            min-height: 100vh;
            letter-spacing: -0.01em;
            line-height: 1.5;
            transition: background 0.3s ease, color 0.3s ease;
        }

        .header {
            margin-bottom: 24px;
            text-align: center;
        }

        .header h1 {
            font-size: 24px;
            font-weight: 700;
            background: linear-gradient(to right, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Page Layout */
        .page {
            display: none;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .page.active {
            display: block;
            opacity: 1;
        }

        /* Staggered Entry Animation */
        @keyframes staggerSlideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .stagger-item {
            opacity: 0;
            animation: staggerSlideIn 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        }

        /* Dashboard/Market Styles */
        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 24px;
        }

        .card {
            background: var(--card-bg);
            backdrop-filter: blur(var(--card-blur));
            -webkit-backdrop-filter: blur(var(--card-blur));
            border: 0.5px solid var(--glass-border);
            border-radius: 20px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .card:active {
            transform: scale(0.96);
        }

        .card-full {
            grid-column: span 2;
        }

        .label {
            font-size: 12px;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        /* --- Dark Mode Adaptation for Iframe (Investing.com) --- */
        body.dark-mode #calendar-container iframe {
            /* Invert colors to match dark theme + hue rotate to keep red/green logic sane */
            filter: invert(0.93) hue-rotate(180deg) contrast(1.1) saturate(0.8) brightness(0.9);
            mix-blend-mode: normal;
        }

        .price {
            font-size: 20px;
            font-weight: 600;
        }

        .change {
            font-size: 12px;
            margin-top: 4px;
        }

        .up {
            color: var(--success-color);
        }

        .down {
            color: var(--danger-color);
        }

        .btn {
            width: 100%;
            background: var(--accent-color);
            color: white;
            border: none;
            padding: 14px 10px;
            border-radius: 16px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .btn:active {
            transform: scale(0.92);
            box-shadow: 0 2px 8px rgba(139, 92, 246, 0.1);
        }

        .button-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 20px;
        }

        /* News Styles */
        .news-card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 16px;
            backdrop-filter: blur(8px);
        }

        .news-tag {
            font-size: 10px;
            background: rgba(56, 189, 248, 0.2);
            color: var(--accent-color);
            padding: 2px 8px;
            border-radius: 4px;
            display: inline-block;
            margin-bottom: 8px;
        }

        .news-title {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .news-meta {
            font-size: 12px;
            color: #94a3b8;
            display: flex;
            justify-content: space-between;
        }

        /* Settings Styles */
        .settings-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .settings-item {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .settings-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .settings-info i {
            color: var(--accent-color);
            font-size: 18px;
            width: 24px;
            text-align: center;
        }

        /* Bottom Nav */
        /* Floating Dock */
        .bottom-nav {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            width: 92%;
            max-width: 400px;
            background: var(--nav-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 0.5px solid var(--glass-border);
            border-radius: 24px;
            display: flex;
            justify-content: space-around;
            padding: 8px 12px;
            z-index: 1000;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 11px;
            gap: 4px;
            flex: 1;
            transition: all 0.3s ease;
            position: relative;
            padding: 8px 0;
        }

        .nav-item.active {
            color: var(--accent-color);
        }

        .nav-item.active i {
            filter: drop-shadow(0 0 8px var(--accent-color));
        }

        .nav-item i {
            font-size: 18px;
            transition: transform 0.3s ease;
        }

        .nav-item:active i {
            transform: scale(1.2);
        }

        .status-badge {
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 99px;
            background: rgba(56, 189, 248, 0.2);
            color: var(--accent-color);
            align-self: flex-start;
            margin-top: 8px;
        }

        /* Calendar Styles */
        .calendar-item {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cal-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .cal-name {
            font-weight: 600;
            font-size: 15px;
        }

        .cal-time {
            font-size: 11px;
            color: #94a3b8;
        }

        .cal-values {
            text-align: right;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .cal-actual {
            font-weight: 700;
            font-size: 16px;
        }

        .cal-forecast {
            font-size: 11px;
            color: #64748b;
        }

        .impact-high {
            color: var(--danger-color);
        }

        .impact-medium {
            color: #f59e0b;
        }

        .impact-low {
            color: var(--success-color);
        }

        /* Funds Styles */
        .fund-card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }

        .fund-detail-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--bg-color);
            z-index: 2000;
            padding: 20px;
            display: none;
            overflow-y: auto;
            animation: slideUp 0.3s ease-out;
        }

        @keyframes slideUp {
            from {
                transform: translateY(100%);
            }

            to {
                transform: translateY(0);
            }
        }

        .detail-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }

        .back-btn {
            font-size: 20px;
            color: var(--accent-color);
            cursor: pointer;
        }

        .detail-section {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 16px;
        }

        .detail-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--accent-color);
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .detail-label {
            color: #94a3b8;
        }

        .detail-value {
            font-weight: 600;
        }

        .score-bar {
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            margin-top: 8px;
            overflow: hidden;
        }

        .score-fill {
            height: 100%;
            background: linear-gradient(to right, var(--accent-color), var(--success-color));
        }

        /* PRO Features CSS */
        .portfolio-summary {
            background: linear-gradient(135deg, var(--accent-color), var(--accent-blue));
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 20px;
            color: white;
            box-shadow: 0 10px 25px rgba(139, 92, 246, 0.3);
        }

        .portfolio-value {
            font-size: 32px;
            font-weight: 700;
            margin: 8px 0;
        }

        .portfolio-change {
            font-size: 16px;
            opacity: 0.9;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .chart-container {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 16px;
            margin-bottom: 24px;
            height: 220px;
        }

        /* Modal / Overlay System */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(10px);
            z-index: 3000;
            display: none;
            padding: 20px;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-content {
            background: var(--bg-color);
            background: var(--bg-gradient);
            border: 1px solid var(--glass-border);
            border-radius: 28px;
            padding: 24px;
            width: 100%;
            max-width: 450px;
            max-height: 85vh;
            overflow-y: auto;
            position: relative;
            animation: modalSlideUp 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        @keyframes modalSlideUp {
            from {
                transform: translateY(50px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-close {
            font-size: 24px;
            color: var(--text-muted);
            cursor: pointer;
        }

        /* Indicators */
        .indicator-card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 12px;
        }

        .signal-badge {
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .signal-buy {
            background: rgba(16, 185, 129, 0.15);
            color: var(--success-color);
        }

        .signal-sell {
            background: rgba(244, 63, 94, 0.15);
            color: var(--danger-color);
        }

        .signal-neutral {
            background: rgba(161, 161, 170, 0.15);
            color: var(--text-muted);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
        }

        .btn-success {
            background: var(--success-color);
        }

        .btn-danger {
            background: var(--danger-color);
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 12px;
            color: var(--text-color);
            font-family: inherit;
        }

        .holding-item {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 12px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
    </style>
</head>

<body>
    <!-- MARKET PAGE -->
    <div id="market-page" class="page active">
        <div class="header"
            style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
            <div style="text-align: left;">
                <h1 style="font-size: 26px; font-weight: 700;">Dashboard PRO</h1>
            </div>
            <div id="theme-toggle" onclick="toggleTheme()"
                style="width: 44px; height: 44px; border-radius: 12px; background: var(--card-bg); border: 0.5px solid var(--glass-border); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease;">
                <i class="fa-solid fa-moon" id="theme-icon"></i>
            </div>
        </div>

        <!-- Portföy Özeti -->
        <div class="portfolio-summary stagger-item">
            <div class="label" style="color: rgba(255,255,255,0.8); margin-bottom: 4px;">Toplam Portföy Değeri</div>
            <div class="portfolio-value" id="portfolio-total-val">$0.00</div>
            <div class="portfolio-change">
                <i class="fa-solid fa-caret-up"></i>
                <span id="portfolio-profit-val">$0.00 (0.00%)</span>
            </div>
        </div>

        <!-- BTC Grafiği -->
        <div class="label stagger-item" style="margin-bottom: 12px; border-left: 3px solid #f59e0b; padding-left: 8px;">
            Bitcoin 24H Analiz</div>
        <div class="chart-container stagger-item">
            <canvas id="btcChart"></canvas>
        </div>

        <!-- Crypto Section -->
        <div class="label" style="margin-bottom: 12px; border-left: 3px solid var(--accent-color); padding-left: 8px;">
            Kripto Varlıklar</div>

        <!-- CryptoRank Marquee Widget -->
        <div id="cr-widget-marquee" data-coins="bitcoin,ethereum,tether,ripple,cardano" data-theme="dark"
            data-show-symbol="true" data-show-icon="true" data-show-period-change="true" data-period-change="24H"
            data-api-url="https://api.cryptorank.io/v0" style="margin-bottom: 20px;">
            <a href="https://cryptorank.io">Coins by Cryptorank</a>
        </div>
        <script src="https://cryptorank.io/widget/marquee.js"></script>

        <!-- Market Cap & Dominance Section -->
        <div class="label" style="margin: 20px 0 12px; border-left: 3px solid #818cf8; padding-left: 8px;">Piyasa
            Verileri</div>
        <div class="grid">
            <div class="card">
                <span class="label">Bitcoin Hakimiyeti</span>
                <span class="price" id="btcd-val">Wait...</span>
            </div>
            <div class="card">
                <span class="label">Kripto Piyasa Değeri</span>
                <span class="price" id="total1-val">Wait...</span>
            </div>
            <!-- Added 24h Volume if possible, otherwise placeholder or remove -->
            <div class="card card-full">
                <span class="label">Hacim (24s)</span>
                <span class="price" id="vol24-val">Wait...</span>
            </div>
        </div>

        <!-- Global Indices Section -->
        <div class="label" style="margin: 20px 0 12px; border-left: 3px solid #10b981; padding-left: 8px;">Küresel
            Endeksler</div>
        <div class="grid">
            <div class="card">
                <span class="label">BIST 100</span>
                <span class="price" id="bist-val">9,120</span>
                <span class="change up">+1.2%</span>
            </div>
            <div class="card">
                <span class="label">NASDAQ</span>
                <span class="price" id="nasdaq-val">16,240</span>
                <span class="change up">+0.8%</span>
            </div>
            <div class="card">
                <span class="label">DOW JONES</span>
                <span class="price" id="dow-val">39,120</span>
                <span class="change down">-0.2%</span>
            </div>
            <div class="card">
                <span class="label">S&P 500</span>
                <span class="price" id="sp500-val">5,210</span>
                <span class="change up">+0.5%</span>
            </div>
        </div>

        <div class="button-group">
            <button class="btn" onclick="executeWebhook('BTC')"><i class="fa-solid fa-bolt"></i> Analyze BTC</button>
            <button class="btn" onclick="executeWebhook('ETH')"><i class="fa-solid fa-bolt"></i> Analyze ETH</button>
            <button class="btn" onclick="executeWebhook('BIST')"><i class="fa-solid fa-chart-line"></i>
                BIST100</button>
            <button class="btn" onclick="executeWebhook('NASDAQ')"><i class="fa-solid fa-arrow-trend-up"></i>
                NASDAQ</button>
            <button class="btn" onclick="executeWebhook('DOW')"><i class="fa-solid fa-landmark"></i> Dow Jones</button>
            <button class="btn" onclick="executeWebhook('SP500')"><i class="fa-solid fa-layer-group"></i> S&P
                500</button>
        </div>
    </div>

    <!-- ANALYSIS PAGE -->
    <div id="analysis-page" class="page">
        <div class="header">
            <h1>Teknik Analiz</h1>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label>Analiz Edilecek Varlık</label>
            <select id="analysis-asset" onchange="updateAnalysis()">
                <option value="BTC">Bitcoin (BTC)</option>
                <option value="ETH">Ethereum (ETH)</option>
                <option value="BIST">BIST 100</option>
            </select>
        </div>

        <div id="analysis-container">
            <div class="indicator-card">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div class="label">RSI (14)</div>
                        <div class="price" id="rsi-val">65.4</div>
                    </div>
                    <div class="signal-badge signal-neutral" id="rsi-signal">Nötr</div>
                </div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">Aşırı alım bölgesine
                    yaklaşıyor.</div>
            </div>

            <div class="indicator-card">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div class="label">MACD</div>
                        <div class="price" id="macd-val">Bullish Cross</div>
                    </div>
                    <div class="signal-badge signal-buy" id="macd-signal">Al</div>
                </div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">Momentum yukarı yönlü
                    güçleniyor.</div>
            </div>

            <div class="indicator-card">
                <div class="label">Hareketli Ortalamalar</div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px;">
                    <div>
                        <div style="font-size: 11px; color: var(--text-muted);">MA 20</div>
                        <div style="font-weight: 600;">$64,120</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: var(--text-muted);">MA 50</div>
                        <div style="font-weight: 600;">$62,800</div>
                    </div>
                </div>
                <div class="signal-badge signal-buy" style="margin-top: 12px;">Güçlü Al</div>
            </div>
        </div>

        <button class="btn" style="margin-top: 20px;" onclick="executeWebhook('TECHNICAL_ANALYSIS')">
            <i class="fa-solid fa-robot"></i> Detaylı Yapay Zeka Raporu
        </button>
    </div>


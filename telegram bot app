    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();
        tg.headerColor = '#0f172a';

        // Page Switching Logic
        function switchPage(pageId, navEl) {
            // Hide all pages
            document.querySelectorAll('.page').forEach(p => {
                p.classList.remove('active');
            });
            // Remove active from nav
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));

            // Show target
            const targetPage = document.getElementById(pageId);
            targetPage.classList.add('active');
            navEl.classList.add('active');

            // Apply staggered animation to items in the new page
            const items = targetPage.querySelectorAll('.card, .news-card, .calendar-item, .fund-card, .label, .btn');
            items.forEach((item, index) => {
                item.classList.remove('stagger-item');
                void item.offsetWidth; // Trigger reflow
                item.style.animationDelay = `${index * 0.05}s`;
                item.classList.add('stagger-item');
            });

            // Haptic Feedback
            if (tg.HapticFeedback) tg.HapticFeedback.impactOccurred('light');
        }

        // Theme Toggle Logic
        function toggleTheme() {
            const body = document.body;
            const currentTheme = body.getAttribute('data-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';
            body.setAttribute('data-theme', newTheme);

            const icon = document.getElementById('theme-icon');
            icon.className = newTheme === 'light' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';

            // WebApp Theme Color update
            tg.headerColor = newTheme === 'light' ? '#f8fafc' : '#09090b';

            if (tg.HapticFeedback) tg.HapticFeedback.selectionChanged();
        }

        // Initial stagger for first page load
        function initAnimations() {
            try {
                const activePage = document.querySelector('.page.active');
                if (!activePage) return;

                // Set page opacity directly to be safe
                activePage.style.opacity = '1';

                const items = activePage.querySelectorAll('.card, .news-card, .calendar-item, .fund-card, .label, .btn');
                if (items.length === 0) {
                    // Fallback for empty looking pages
                    activePage.querySelectorAll('*').forEach(el => el.style.opacity = '1');
                }

                items.forEach((item, index) => {
                    item.style.animationDelay = `${index * 0.05}s`;
                    item.classList.add('stagger-item');
                });
            } catch (e) {
                console.error("Animation Init Error:", e);
                document.querySelectorAll('*').forEach(el => el.style.opacity = '1');
            }
        }

        // Run as soon as possible
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAnimations);
        } else {
            initAnimations();
        }

        // Mock Webhook Logic
        async function executeWebhook(symbol) {
            try {
                // Show local feedback immediately
                if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');

                // IMPORTANT: Using V2 Webhook URL to force fresh workflow logic
                const WEBHOOK_URL = 'https://portably-inadvertent-hermine.ngrok-free.dev/webhook/analyze-market-v2';
                const response = await fetch(WEBHOOK_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        user: tg.initDataUnsafe?.user?.username || 'Guest',
                        symbol: symbol, // Ensure 'BIST' is passed for BIST100 button
                        timestamp: new Date().toISOString()
                    })
                });
                if (response.ok) {
                    tg.showAlert(`✅ ${symbol} analiz isteği gönderildi!`);
                } else {
                    const errText = await response.text();
                    console.error('Webhook Error:', response.status, errText);
                    tg.showAlert(`⚠️ Hata: ${response.status} - ${response.statusText}\nLütfen n8n konsolunu kontrol edin.`);
                }
            } catch (e) {
                console.error("Fetch/Network Error:", e);
                tg.showAlert(`❌ Bağlantı Hatası: ${e.message}\nCORS ayarı veya ngrok kapalı olabilir.`);
            }
        }

        // Settings Interactivity
        function toggleStrategy() {
            const el = document.getElementById('strategy-mode');
            const current = el.innerText;
            const next = current === 'Turbo' ? 'Safe' : 'Turbo';
            el.innerText = next;
            if (tg.HapticFeedback) tg.HapticFeedback.selectionChanged();
            tg.showScanQrPopup({ text: `Strategy changed to ${next}` });
            setTimeout(() => tg.closeScanQrPopup(), 1000);
        }

        function confirmReset() {
            tg.showConfirm('Are you sure you want to reset cache?', (ok) => {
                if (ok) {
                    tg.showAlert('Cache cleared!');
                    if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('warning');
                }
            });
        }

        // --- PRO Logic: Modals & Portfolio ---
        function openModal(id) {
            document.getElementById(id).classList.add('active');
            if (id === 'portfolio-modal') updateHoldingsUI();
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        let holdings = JSON.parse(localStorage.getItem('user_holdings') || '[]');

        function saveHolding() {
            const asset = document.getElementById('holding-asset').value;
            const amount = parseFloat(document.getElementById('holding-amount').value);
            const cost = parseFloat(document.getElementById('holding-cost').value);

            if (!amount || !cost) {
                tg.showAlert('Lütfen miktar ve maliyet giriniz!');
                return;
            }

            holdings.push({ asset, amount, cost, id: Date.now() });
            localStorage.setItem('user_holdings', JSON.stringify(holdings));
            closeModal('add-holding-modal');
            updateHoldingsUI();
            tg.showAlert('Varlık başarıyla eklendi!');
        }

        function deleteHolding(id) {
            holdings = holdings.filter(h => h.id !== id);
            localStorage.setItem('user_holdings', JSON.stringify(holdings));
            updateHoldingsUI();
        }

        // --- Robust Fetching Utility ---
        async function fetchWithProxy(url, asJson = true) {
            const timestamp = new Date().getTime();
            const proxies = [
                // AllOrigins (JSON wrapped)
                {
                    url: u => `https://api.allorigins.win/get?url=${encodeURIComponent(u)}&_=${timestamp}`,
                    process: async (res) => {
                        const data = await res.json();
                        return asJson ? JSON.parse(data.contents) : data.contents;
                    }
                },
                // CorsProxy.io (Direct)
                {
                    url: u => `https://corsproxy.io/?${encodeURIComponent(u)}&_=${timestamp}`,
                    process: async (res) => asJson ? await res.json() : await res.text()
                }
            ];

            for (const proxy of proxies) {
                try {
                    const response = await fetch(proxy.url(url), { cache: 'no-store' });
                    if (response.ok) return await proxy.process(response);
                } catch (e) {
                    console.warn(`Proxy failed: ${e.message}`);
                }
            }
            throw new Error(`All proxies failed for ${url}`);
        }

        async function updateHoldingsUI() {
            const container = document.getElementById('holdings-list');
            if (!container) return;
            if (holdings.length === 0) {
                container.innerHTML = '<div style="text-align: center; color: var(--text-muted); padding: 20px;">Henüz varlık eklemediniz.</div>';
                return;
            }

            let html = '';
            let totalVal = 0;
            let totalCost = 0;

            for (const h of holdings) {
                // Not: Gerçek uygulamada fiyatlar API'den çekilmeli
                // Simülasyon için BTC=65000, ETH=3500 baz alıyoruz
                const currentPrice = h.asset === 'BTC' ? 65000 : 3500;
                const value = h.amount * currentPrice;
                const profit = value - (h.amount * h.cost);
                totalVal += value;
                totalCost += (h.amount * h.cost);

                html += `
                    <div class="holding-item">
                        <div>
                            <div style="font-weight:700;">${h.asset}</div>
                            <div style="font-size:12px; color:var(--text-muted);">${h.amount} ${h.asset}</div>
                        </div>
                        <div style="text-align:right;">
                            <div style="font-weight:600;">$${value.toLocaleString()}</div>
                            <div style="font-size:11px; color:${profit >= 0 ? 'var(--success-color)' : 'var(--danger-color)'};">
                                ${profit >= 0 ? '+' : ''}$${profit.toFixed(2)}
                            </div>
                        </div>
                        <i class="fa-solid fa-trash" onclick="deleteHolding(${h.id})" style="color:var(--danger-color); margin-left:12px; cursor:pointer; opacity:0.6;"></i>
                    </div>
                `;
            }
            container.innerHTML = html;

            // Market sayfasındaki özeti güncelle
            document.getElementById('portfolio-total-val').innerText = `$${totalVal.toLocaleString()}`;
            const totalProfitPercent = totalCost > 0 ? ((totalVal - totalCost) / totalCost * 100) : 0;
